# Proxied mode (default): a relative prefix keeps requests same-origin; the Vite dev
# server strips it and forwards to VITE_PROXY_TARGET, so the browser never sees CORS.
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:5000

# Direct cross-origin mode: an absolute URL skips the proxy and the browser calls the
# backend itself; the backend's Flask-CORS must allow this origin with credentials.
# VITE_API_BASE_URL=http://localhost:5000
